# CSV hashes deliberately normalize CRLF/LF; use portable LF checkouts.
*.csv text eol=lf
# Frozen evidence predates this policy: preserve its original committed bytes.
results/archive/**/*.csv -text
# Manifest hashes for JSON are byte hashes. Preserve their generated bytes on all OSes.
results/**/*.json -text
results/**/*.jsonl -text
# Binary research figures must never undergo text conversion.
*.png binary
